# 复制为 .env 后填写。.env 已被 gitignore，绝不能提交。
PORT=3000
DATA_DIR=/app/data

# Docker 网络内用服务名；宿主机直跑时改成 ws://127.0.0.1:10095
ASR_HOST=ws://asr:10095
# 语音识别实现：funasr（本地 Docker，离线）| tencent（腾讯云一句话识别，5000 次/月免费）
ASR_PROVIDER=funasr
# ASR_PROVIDER=tencent 时必填（console.cloud.tencent.com/cam/capi 获取）
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
TTS_URL=http://tts:55001

# zhipu | ollama（M2 解析用）
LLM_PROVIDER=zhipu
ZHIPU_API_KEY=在此粘贴你的智谱APIKey
