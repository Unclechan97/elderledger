# 复制为 .env 后填写。.env 已被 gitignore，绝不能提交。
PORT=3000
DATA_DIR=/app/data

# Docker 网络内用服务名；宿主机直跑时改成 ws://127.0.0.1:10095
ASR_HOST=ws://asr:10095
# 语音识别实现：funasr（本地 Docker）；将来接云 API/sherpa-onnx 时在 services/asr/ 加实现再改这里
ASR_PROVIDER=funasr
TTS_URL=http://tts:55001

# zhipu | ollama（M2 解析用）
LLM_PROVIDER=zhipu
ZHIPU_API_KEY=在此粘贴你的智谱APIKey
