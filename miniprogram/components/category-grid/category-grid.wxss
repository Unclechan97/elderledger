.cg {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.cg-item {
  width: 158rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.cg-active {
  border: 4rpx solid #FF7043;
  background: #FFF3EE;
}

.cg-press {
  background: #FFE3D6;
}

.cg-icon {
  font-size: 52rpx;
}

.cg-name {
  margin-top: 8rpx;
  font-size: 28rpx;
}
