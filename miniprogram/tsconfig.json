{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["miniprogram-api-typings"]
  },
  "include": ["**/*.ts", "typings/**/*.d.ts"],
  "exclude": ["node_modules"]
}
