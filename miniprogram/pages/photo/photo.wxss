.page {
  padding: 32rpx;
  min-height: 80vh;
  box-sizing: border-box;
}

.pick-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.pick-hint {
  margin-bottom: 48rpx;
  font-size: 36rpx;
  color: #8A8177;
}

/* 超大入口按钮 */
.pick-btn {
  width: 100%;
  height: 160rpx;
  margin-bottom: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF7043;
  border-radius: 28rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 112, 67, 0.3);
}

.pick-btn:nth-of-type(3) {
  background: #FFFFFF;
  color: #6D655B;
  border: 2rpx solid #EADFD2;
  box-shadow: none;
}

.pick-press {
  opacity: 0.85;
}

.working-area,
.result-area,
.fail-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview {
  width: 480rpx;
  height: 480rpx;
  border-radius: 24rpx;
  background: #F5EEE4;
}

.preview-small {
  width: 280rpx;
  height: 280rpx;
  border-radius: 20rpx;
  background: #F5EEE4;
  margin-bottom: 24rpx;
}

.working-text {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #8A8177;
}

.result-area {
  width: 100%;
  margin-top: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.result-line {
  font-size: 56rpx;
  font-weight: 700;
  text-align: center;
  padding: 12rpx 0;
}

.btn-row {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
  width: 100%;
}

.btn {
  flex: 1;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.btn.retry {
  background: #F5EEE4;
  color: #6D655B;
}

.btn.ok {
  background: #2E7D32;
  color: #FFFFFF;
}

.btn-press {
  opacity: 0.85;
}

.fail-area {
  margin-top: 60rpx;
}

.fail-emoji {
  font-size: 96rpx;
}

.fail-text {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #D84315;
  text-align: center;
  line-height: 1.5;
}
