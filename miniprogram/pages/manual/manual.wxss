.page {
  padding: 24rpx 32rpx 48rpx;
}

/* 家人代记横幅 */
.as-banner {
  background: #E3F2FD;
  color: #1565C0;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.kind-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.kind-tab {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 20rpx;
  font-size: 38rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.kind-active {
  background: #FF7043;
  border-color: #FF7043;
  color: #FFFFFF;
}

.tab-press {
  opacity: 0.85;
}

/* 金额展示 ≥ 72rpx */
.amount-display {
  text-align: center;
  font-size: 96rpx;
  font-weight: 700;
  color: #D84315;
  padding: 20rpx 0 12rpx;
}

.amount-unit {
  font-size: 40rpx;
  font-weight: 500;
  color: #8A8177;
}

.section-label {
  margin: 8rpx 0 16rpx;
  font-size: 32rpx;
  color: #8A8177;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  margin-top: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 20rpx;
  padding: 0 32rpx;
}

.date-label {
  font-size: 36rpx;
  color: #8A8177;
}

.date-value {
  font-size: 38rpx;
  font-weight: 600;
}

.save-btn {
  margin-top: 28rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF7043;
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.save-press {
  background: #F4511E;
}

/* 次级：完成退出（连续记账模式下主动收尾） */
.done-btn {
  margin-top: 20rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5EEE4;
  border-radius: 20rpx;
  color: #6D655B;
  font-size: 36rpx;
  font-weight: 600;
}

.done-press {
  background: #FFE3D6;
}
