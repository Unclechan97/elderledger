<view class="page">
  <!-- 首次使用引导：一页大图 + 语音讲解（适老化原则 8） -->
  <view class="guide-mask" wx:if="{{showGuide}}">
    <view class="guide-card">
      <view class="guide-title">欢迎使用银龄记账</view>
      <view class="guide-row"><view class="guide-icon">🎤</view><view class="guide-text">按住说话，念出花销</view></view>
      <view class="guide-row"><view class="guide-icon">📷</view><view class="guide-text">拍支付页面或小票</view></view>
      <view class="guide-row"><view class="guide-icon">✋</view><view class="guide-text">也可以手动按键记录</view></view>
      <view class="guide-btn" hover-class="btn-press" bindtap="onGuideDone">知道了，开始</view>
    </view>
  </view>

  <view class="header">
    <view class="date">{{dateText}}</view>
    <view class="summary-label">本月已花</view>
    <view class="summary-amount">¥ {{totalText}}</view>
    <view class="summary-diff" wx:if="{{diffText}}">{{diffText}}</view>
  </view>

  <view class="big-btn primary" hover-class="btn-press" bindtap="onVoiceTap">🎤 说 一 笔</view>
  <view class="big-btn" hover-class="btn-press" bindtap="onPhotoTap">📷 拍 一 张</view>
  <view class="big-btn" hover-class="btn-press" bindtap="onManualTap">✋ 手 动 记</view>

  <view class="nav-row">
    <view class="nav-item" hover-class="nav-press" bindtap="onListTap"><view class="nav-icon">📋</view><view class="nav-text">明细</view></view>
    <view class="nav-item" hover-class="nav-press" bindtap="onStatsTap"><view class="nav-icon">📊</view><view class="nav-text">统计</view></view>
    <view class="nav-item" hover-class="nav-press" bindtap="onFamilyTap"><view class="nav-icon">🧑‍🤝‍🧑</view><view class="nav-text">家人</view></view>
    <view class="nav-item" hover-class="nav-press" bindtap="onToggleSound"><view class="nav-icon">{{ttsOn ? '🔊' : '🔇'}}</view><view class="nav-text">声音{{ttsOn ? '开' : '关'}}</view></view>
  </view>
</view>
