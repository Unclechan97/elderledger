<view class="page">
  <view class="header">
    <view class="date">{{dateText}}</view>
    <view class="summary-label">本月已花</view>
    <view class="summary-amount">¥ {{totalText}}</view>
    <view class="summary-diff" wx:if="{{diffText}}">{{diffText}}</view>
  </view>

  <view class="big-btn primary" hover-class="btn-press" bindtap="onVoiceTap">🎤 说 一 笔</view>
  <view class="big-btn" hover-class="btn-press" bindtap="onPhotoTap">📷 拍 一 张</view>
  <view class="big-btn" hover-class="btn-press" bindtap="onManualTap">✋ 手 动 记</view>

  <view class="nav-row">
    <view class="nav-item" hover-class="nav-press" bindtap="onListTap">📋 明细</view>
    <view class="nav-item" hover-class="nav-press" bindtap="onStatsTap">📊 统计</view>
    <view class="nav-item" hover-class="nav-press" bindtap="onFamilyTap">🧑‍🤝‍🧑 家人</view>
  </view>
</view>
