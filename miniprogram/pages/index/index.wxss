.page {
  padding: 32rpx;
}

.header {
  text-align: center;
  padding: 24rpx 0 44rpx;
}

.date {
  font-size: 34rpx;
  color: #8A8177;
}

.summary-label {
  margin-top: 28rpx;
  font-size: 36rpx;
}

.summary-amount {
  margin-top: 8rpx;
  font-size: 88rpx;
  font-weight: 700;
  color: #D84315;
}

.summary-diff {
  margin-top: 12rpx;
  font-size: 36rpx;
  color: #2E7D32;
}

/* 触控目标 ≥ 128rpx，按钮间距充分 */
.big-btn {
  height: 128rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.primary {
  background: #FF7043;
  border-color: #FF7043;
  color: #FFFFFF;
}

.btn-press {
  opacity: 0.85;
}

.hint {
  margin: 8rpx 0 40rpx;
  text-align: center;
  font-size: 30rpx;
  color: #8A8177;
}

/* M1：明细/统计/家人 导航行 */
.nav-row {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.nav-item {
  flex: 1;
  height: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5EEE4;
  border-radius: 20rpx;
}

.nav-icon {
  font-size: 44rpx;
  line-height: 1.2;
}

.nav-text {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.nav-press {
  background: #FFE3D6;
}

/* 首次使用引导层 */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 248, 240, 0.97);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.guide-card {
  width: 100%;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.guide-title {
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 40rpx;
}

.guide-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.guide-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.guide-text {
  font-size: 38rpx;
  font-weight: 600;
}

.guide-btn {
  margin-top: 44rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF7043;
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 700;
}
