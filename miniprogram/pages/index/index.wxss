.page {
  padding: 32rpx;
}

.header {
  text-align: center;
  padding: 24rpx 0 44rpx;
}

.date {
  font-size: 34rpx;
  color: #8A8177;
}

.summary-label {
  margin-top: 28rpx;
  font-size: 36rpx;
}

.summary-amount {
  margin-top: 8rpx;
  font-size: 88rpx;
  font-weight: 700;
  color: #D84315;
}

/* 触控目标 ≥ 128rpx，按钮间距充分 */
.big-btn {
  height: 128rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.primary {
  background: #FF7043;
  border-color: #FF7043;
  color: #FFFFFF;
}

.hint {
  margin: 8rpx 0 40rpx;
  text-align: center;
  font-size: 30rpx;
  color: #8A8177;
}

/* M1：明细/统计/家人 导航行 */
.nav-row {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.nav-item {
  flex: 1;
  height: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5EEE4;
  border-radius: 20rpx;
}

.nav-icon {
  font-size: 44rpx;
  line-height: 1.2;
}

.nav-text {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.nav-press {
  background: #FFE3D6;
}
