.page {
  padding: 32rpx;
}

.header {
  text-align: center;
  padding: 24rpx 0 44rpx;
}

.date {
  font-size: 34rpx;
  color: #8A8177;
}

.summary-label {
  margin-top: 28rpx;
  font-size: 36rpx;
}

.summary-amount {
  margin-top: 8rpx;
  font-size: 88rpx;
  font-weight: 700;
  color: #D84315;
}

/* 触控目标 ≥ 128rpx，按钮间距充分 */
.big-btn {
  height: 128rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.primary {
  background: #FF7043;
  border-color: #FF7043;
  color: #FFFFFF;
}

.hint {
  margin: 8rpx 0 40rpx;
  text-align: center;
  font-size: 30rpx;
  color: #8A8177;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  color: #8A8177;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center; /* 不足一行的末行居中 */
  gap: 16rpx;
}

.cat-item {
  width: 158rpx; /* 4 列 ×158 + 3 间距 ×16 = 680 ≤ 内容区 686rpx */
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 20rpx;
}

.cat-icon {
  font-size: 52rpx;
}

.cat-name {
  margin-top: 8rpx;
  font-size: 28rpx;
}
