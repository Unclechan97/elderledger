.page {
  padding: 24rpx 32rpx 48rpx;
}

/* 家人代看横幅：只读提示 */
.as-banner {
  background: #E3F2FD;
  color: #1565C0;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.range-tabs {
  display: flex;
  gap: 20rpx;
}

.range-tab {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 20rpx;
  font-size: 38rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.range-active {
  background: #FF7043;
  border-color: #FF7043;
  color: #FFFFFF;
}

.tab-press {
  opacity: 0.85;
}

.sum-row {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 8rpx;
  font-size: 34rpx;
}

.sum-out {
  color: #D84315;
  font-weight: 600;
}

.sum-in {
  color: #2E7D32;
  font-weight: 600;
}

.txn-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #EADFD2;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.txn-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.txn-main {
  flex: 1;
  min-width: 0;
}

.txn-cat {
  font-size: 38rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 语音原话：完整换行展示（入库时截 100 字兜底行高），不搞点击展开——老人不猜交互 */
.txn-note {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: #8A8177;
  word-break: break-all;
}

.txn-date {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #8A8177;
}

/* 家人代记标识：与代看横幅同色系，语义一致 */
.txn-family {
  color: #1565C0;
}

.txn-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.txn-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #D84315;
}

.txn-amount-in {
  color: #2E7D32;
}

/* 删除按钮：次级操作触控目标 ≥72rpx，字号 ≥30rpx */
.txn-del {
  margin-top: 8rpx;
  min-width: 96rpx;
  height: 72rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #B0A69A;
  background: #F5EEE4;
  border-radius: 12rpx;
}

.del-press {
  color: #D84315;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 36rpx;
  color: #8A8177;
}

/* 触底加载状态：弱化呈现，不抢注意力 */
.list-footer {
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.footer-text {
  font-size: 30rpx;
  color: #B0A69A;
}
