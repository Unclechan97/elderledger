.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #fff8f0;
}

.sum-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.sum-label {
  font-size: 36rpx;
  color: #6d4c41;
  margin-bottom: 8rpx;
}

.sum-amount {
  font-size: 96rpx;
  font-weight: 700;
  color: #d84315;
  line-height: 1.2;
}

.sum-diff {
  margin-top: 8rpx;
  font-size: 36rpx;
  color: #8d6e63;
}

.sum-income {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #2e7d32;
}

.sec-label {
  font-size: 38rpx;
  font-weight: 600;
  color: #3e2723;
  margin: 0 8rpx 20rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.cat-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}

.cat-main {
  flex: 1;
  min-width: 0;
}

.cat-line {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.cat-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #3e2723;
}

.cat-cnt {
  font-size: 30rpx;
  color: #a1887f;
  margin-left: 16rpx;
  flex: 1;
}

.cat-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #d84315;
}

.bar-track {
  height: 24rpx;
  background: #f5eee4;
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 40rpx;
  color: #8a8177;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: 34rpx;
  color: #a1887f;
}
