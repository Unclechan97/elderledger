<view class="page">
  <!-- 老人视角：出示邀请码 -->
  <block wx:if="{{mode === 'elder'}}">
    <view class="hero-card">
      <view class="hero-title">让家人看到你的账本</view>
      <view class="hero-desc">把下面的码告诉子女。子女绑定后，能看到你的记账，也能帮你记账。</view>
      <view class="invite-code" wx:if="{{inviteCode}}">{{inviteCode}}</view>
      <view class="invite-empty" wx:else>还没有邀请码</view>
      <view class="big-btn" hover-class="btn-press" bindtap="onCreateInvite">{{inviteCode ? '换一个码' : '生成邀请码'}}</view>
    </view>
    <view class="mini-link" bindtap="onGoBind">我是子女？输入邀请码绑定（测试）</view>
  </block>

  <!-- 绑定视图（本地开发：同一台设备模拟子女端） -->
  <block wx:if="{{mode === 'bind'}}">
    <view class="hero-card">
      <view class="hero-title">绑定家人账本</view>
      <view class="hero-desc">输入老人念给你的 6 位邀请码</view>
      <input class="bind-input" value="{{bindCode}}" bindinput="onBindInput" maxlength="6" placeholder="如 AB23CD" />
      <view class="big-btn" hover-class="btn-press" bindtap="onBindSubmit">绑 定</view>
      <view class="mini-link" bindtap="onBindCancel">取消，返回</view>
    </view>
  </block>

  <!-- 家人视角：老人账本汇总 + 操作 -->
  <block wx:if="{{mode === 'managing'}}">
    <view class="hero-card">
      <view class="hero-title">{{elderName}} 的账本</view>
      <view class="stat-row">
        <view class="stat">
          <view class="stat-num">¥ {{elderExpenseText}}</view>
          <view class="stat-label">本月支出</view>
        </view>
        <view class="stat">
          <view class="stat-num stat-num-in">¥ {{elderIncomeText}}</view>
          <view class="stat-label">本月收入</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{elderCount}}</view>
          <view class="stat-label">本月笔数</view>
        </view>
      </view>
    </view>
    <view class="big-btn" hover-class="btn-press" bindtap="onViewList">📋 看明细</view>
    <view class="big-btn" hover-class="btn-press" bindtap="onViewManual">✋ 代记一笔</view>
    <view class="big-btn" hover-class="btn-press" bindtap="onExport">📤 导出本月账单</view>
    <view class="mini-link" bindtap="onBackToElder">调试：切回老人身份</view>
  </block>

  <view wx:if="{{mode === 'loading'}}" class="loading">加载中…</view>
</view>
